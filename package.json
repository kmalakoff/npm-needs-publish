{
  "name": "npm-needs-publish",
  "version": "1.1.2",
  "description": "Smart publish detection for npm packages - semantic package.json comparison with semver-aware dependency analysis",
  "keywords": [
    "npm",
    "publish",
    "detection",
    "semver",
    "semantic",
    "version",
    "comparison",
    "package.json",
    "dependencies"
  ],
  "homepage": "https://github.com/kmalakoff/npm-needs-publish#readme",
  "bugs": {
    "url": "https://github.com/kmalakoff/npm-needs-publish/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kmalakoff/npm-needs-publish.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff.info@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "nnp": "bin/cli.js",
    "npm-needs-publish": "bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "tsds test:node --no-timeouts",
    "test:engines": "nvu engines tsds test:node --no-timeouts",
    "version": "tsds version"
  },
  "dependencies": {
    "cross-spawn-cb": "^3.2.3",
    "exit-compat": "^1.0.5",
    "getopts-compat": "^2.2.6",
    "npm-package-arg": "^7.0.0",
    "semver": "^7.7.3",
    "tar-stream": "^2.2.0"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "@types/npm-package-arg": "^6.1.4",
    "@types/resolve": "^1.20.6",
    "@types/semver": "^7.7.1",
    "@types/short-hash": "^1.0.3",
    "@types/tar-stream": "^3.1.4",
    "cr": "^0.1.0",
    "fs-copy-compat": "^1.0.0",
    "fs-remove-compat": "^1.0.0",
    "is-version": "^1.0.9",
    "mkdirp-classic": "^0.5.2",
    "module-link-unlink": "^1.0.11",
    "node-version-use": "*",
    "os-shim": "^0.1.0",
    "queue-cb": "^1.0.0",
    "resolve": "^1.3.1",
    "short-hash": "^1.0.0",
    "temp-suffix": "^1.0.10",
    "ts-dev-stack": "*",
    "tsds-config": "*",
    "tsds-lib-test": "^1.21.4"
  },
  "engines": {
    "node": ">=6"
  },
  "allowScripts": {
    "node-filename-to-dist-paths": true,
    "node-semvers": true,
    "node-version-use": true,
    "thread-sleep-compat": true
  }
}
